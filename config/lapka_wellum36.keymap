#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

&sk {
    release-after-ms = <60000>;
};

/ {
    behaviors {
        m_release_key_twice: m_release_key_twice {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_release
                &macro_param_1to1 &kp 0
                &macro_param_1to1 &kp 0
            >;
        };

        m_press_key_twice: m_press_key_twice {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_press
                &macro_param_1to1 &kp 0
                &macro_param_1to1 &kp 0
                &macro_pause_for_release
                &macro_tap
                &m_release_key_twice 0
            >;
        };

        sticky_forever: sticky_forever {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&m_press_key_twice>;
            release-after-ms = <4294967295>;
            ignore-modifiers;
        };

        cm_gui: cm_gui {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LGUI>, <&m_release_key_twice LGUI>;
            mods = <MOD_LGUI>;
            keep-mods = <MOD_LGUI>;
        };

        cm_alt: cm_alt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LALT>, <&m_release_key_twice LALT>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        cm_ctrl: cm_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LCTRL>, <&m_release_key_twice LCTRL>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };

        cm_sft: cm_sft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sticky_forever LSHIFT>, <&m_release_key_twice LSHIFT>;
            mods = <MOD_LSFT>;
            keep-mods = <MOD_LSFT>;
        };

        m_hold_mod_press_key: m_hold_mod_press_key {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_press
                &macro_param_1to1 &kp 0
                &macro_tap
                &macro_param_2to1 &kp 0
            >;
        };

        tabber: tabber {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LCTRL TAB>, <&kp TAB>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };

        swapper_win: swapper_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LALT TAB>, <&kp TAB>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        swapper_mac: swapper_mac {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&m_hold_mod_press_key LGUI TAB>, <&kp TAB>;
            mods = <MOD_LGUI>;
            keep-mods = <MOD_LGUI>;
        };

        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <
                &macro_tap
                &kp 0
                &macro_press
                &macro_param_1to1 &mo 0
                &macro_pause_for_release
                &macro_release
                &macro_param_1to1 &mo 0
                &kp LSHFT
                &kp LCTRL
                &kp LALT
                &kp LGUI
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        def_layer {
            bindings = <
                &kp Q          &kp W          &kp E          &kp R         &kp T             &kp Y          &kp U          &kp I          &kp O          &kp P
                &kp A          &kp S          &kp D          &kp F         &kp G             &kp H          &kp J          &kp K          &kp L          &kp SEMI
                &kp Z          &kp X          &kp C          &kp V         &kp B             &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH
                                 &kp CAPS       &kp SPACE     &la 3         &la 4      &kp LSFT       &kp RALT
            >;
        };

        gam_layer {
            bindings = <
                &kp TAB        &kp Q          &kp W          &kp E         &kp R             &none          &none          &kp UP         &none          &kp TAB
                &kp LSFT       &kp A          &kp S          &kp D         &kp F             &none          &kp LEFT       &kp DOWN       &kp RIGHT      &kp RSFT
                &kp LCTRL      &kp Z          &kp X          &kp C         &kp V             &none          &none          &none          &none          &kp RCTRL
                                 &kp LALT       &kp SPACE     &mo 2         &tog 1     &kp SPACE      &trans
            >;
        };

        gfn_layer {
            bindings = <
                &kp N5         &kp N1         &kp N2         &kp N3        &kp N4            &out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2 &bt BT_CLR_ALL
                &kp N0         &kp N6         &kp N7         &kp N8        &kp N9            &none          &none          &none            &none          &none
                &kp G          &kp J          &kp I          &kp M         &kp T             &kp KP_NUM     &none          &none            &sys_reset   &bootloader
                                 &kp ESC        &kp RET       &trans          &trans       &trans       &none
            >;
        };

        nav_layer {
            bindings = <
                &tabber      &swapper_win &swapper_mac &none         &kp ESC           &kp ESC        &kp HOME       &kp END        &kp BSPC       &kp DEL
                &cm_gui      &cm_alt      &cm_ctrl     &cm_sft     &kp RET           &kp RET        &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT
                &kp LC(LG(LEFT))       &kp LC(LG(RIGHT))       &tog 1     &kp PSCRN     &kp TAB           &kp TAB        &kp PG_UP      &kp PG_DN      &kp APOS       &kp KP_NUM
                                 &mo 6      &trans      &trans          &trans       &trans       &trans
            >;
        };

        sym_layer {
            bindings = <
                &kp N1         &kp N2         &kp N3         &kp N4        &kp N5            &kp N6         &kp N7         &kp N8         &kp N9         &kp N0
                &kp SEMI       &kp RA(GRAVE)        &kp GRAVE        &kp LS(GRAVE)       &kp MINUS         &kp PLUS       &cm_sft      &cm_ctrl     &cm_alt      &cm_gui
                &kp RA(BSLH)        &none          &kp LS(LBKT)   &kp LBKT      &kp UNDER         &kp EQUAL      &kp RBKT       &kp LS(RBKT)   &kp LS(BSLH)        &kp BSLH
                                 &trans       &trans      &trans          &trans       &trans       &kp RALT
            >;
        };

        num_layer {
            bindings = <
                &kp KP_N1      &kp KP_N2      &kp KP_N3      &kp KP_N4     &kp KP_N5         &kp KP_N6      &kp KP_N7      &kp KP_N8      &kp KP_N9      &kp KP_N0
                &cm_gui      &cm_alt      &cm_ctrl     &cm_sft     &kp F11           &kp F12        &cm_sft      &cm_ctrl     &cm_alt      &cm_gui
                &kp F1         &kp F2         &kp F3         &kp F4        &kp F5            &kp F6         &kp F7         &kp F8         &kp F9         &kp F10
                                 &trans       &trans      &trans          &trans       &trans       &trans
            >;
        };

        cmd_layer {
            bindings = <
                &kp LS(LC(LA(Q)))     &kp LS(LC(LA(W)))     &kp LS(LC(LA(E)))     &kp LS(LC(LA(R)))    &kp LS(LC(LA(T)))        &kp LS(LC(LA(Y)))     &kp C_VOL_DN   &kp C_MUTE     &kp C_VOL_UP   &kp LS(LC(LA(P)))
                &kp LS(LC(LA(A)))     &kp LS(LC(LA(S)))     &kp LS(LC(LA(D)))     &kp LS(LC(LA(F)))    &kp LS(LC(LA(G)))        &kp LS(LC(LA(H)))     &kp C_PREV     &kp C_PP       &kp C_NEXT     &kp LS(LC(LA(SEMI)))
                &kp LS(LC(LA(Z)))     &kp LS(LC(LA(X)))     &kp LS(LC(LA(C)))     &kp LS(LC(LA(V)))    &kp LS(LC(LA(B)))        &kp LS(LC(LA(N)))     &kp LS(LC(LA(M)))     &kp LS(LC(LA(COMMA))) &kp LS(LC(LA(DOT)))   &kp LS(LC(LA(FSLH)))
                                 &trans       &trans      &trans          &trans       &trans       &trans
            >;
        };
    };
};
