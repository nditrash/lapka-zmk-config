#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    &mt {
        tapping-term-ms = <100>;
        flavor = "tap-preferred";
    };

    combos {
        compatible = "zmk,combos";

        rus_left {
            bindings = <&kp LS(LG(NUMBER_1))>;
            key-positions = <21 22>;
        };

        eng_left {
            bindings = <&kp LG(LS(NUMBER_2))>;
            key-positions = <23 22>;
        };

        rus_right {
            bindings = <&kp LS(LG(NUMBER_1))>;
            key-positions = <27 28>;
        };

        eng_right {
            bindings = <&kp LG(LS(NUMBER_2))>;
            key-positions = <26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        def_layer {
            bindings = <
&kp Q        &kp W             &kp E      &kp R  &kp T           &kp Y            &kp U  &kp I          &kp O                &kp P
&kp A        &kp S             &kp D      &kp F  &mt LEFT_WIN G  &kp H            &kp J  &kp K          &kp L                &kp SEMICOLON
&mt LCTRL Z  &mt LEFT_SHIFT X  &kp C      &kp V  &mt LEFT_ALT B  &mt LEFT_ALT N   &kp M  &kp COMMA      &mt LEFT_SHIFT DOT   &mt LCTRL SLASH
                               &kp SPACE  &mo 1  &mo 2           &mo 3            &mo 4  &kp BACKSPACE
            >;
        };

        nav_layer {
            bindings = <
&kp LG(Q)   &kp LG(MINUS)  &kp LG(EQUAL)  &kp LG(R)  &kp LC(LS(TAB))   &kp RC(TAB)  &kp C_PREVIOUS  &kp C_NEXT      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&kp ESCAPE  &kp LG(H)      &kp LG(K)      &kp LG(L)  &kp ENTER         &kp ENTER    &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW    &kp PG_UP
&kp LCTRL   &kp LSHIFT     &kp LG(J)      &kp LG(C)  &kp C_PLAY_PAUSE  &kp C_MUTE   &kp HOME        &kp DOWN_ARROW  &kp END            &kp PAGE_DOWN
                           &trans         &trans     &trans            &kp TAB      &trans          &trans
            >;
        };

        fn_layer {
            bindings = <
&kp F13   &kp F14  &kp F15  &kp F16  &kp F17  &trans  &trans   &trans   &trans   &trans
&kp LALT  &kp F1   &kp F2   &kp F3   &kp F18  &trans  &kp F7   &kp F8   &kp F9   &trans
&kp F20   &kp F4   &kp F5   &kp F6   &kp F19  &trans  &kp F10  &kp F11  &kp F12  &trans
                   &trans   &trans   &trans   &trans  &trans   &trans
            >;
        };

        ralt_layer {
            bindings = <
&kp RA(Q)  &kp RA(W)  &kp RA(E)  &kp RA(R)   &kp RA(T)  &kp RA(Y)  &kp RA(U)  &kp RA(I)      &kp RA(O)       &kp RA(P)
&kp RA(A)  &kp RA(S)  &kp RA(D)  &kp RA(F)   &kp RA(G)  &kp RA(H)  &kp RA(J)  &kp RA(K)      &kp RA(L)       &kp RA(SEMI)
&kp RA(Z)  &kp RA(X)  &kp RA(C)  &kp RA(V)   &kp RA(B)  &kp RA(N)  &kp RA(M)  &kp RA(COMMA)  &kp RA(PERIOD)  &kp RA(FSLH)
                      &kp SPACE  &kp DELETE  &trans     &trans     &trans     &trans
            >;
        };

        sym_layer {
            bindings = <
&kp N1         &kp N2       &kp N3         &kp N4            &kp N5        &kp N6      &kp N7        &kp N8        &kp N9             &kp N0
&mo 5          &kp RA(DOT)  &kp RA(COMMA)  &kp RA(LS(FSLH))  &kp RA(FSLH)  &kp APOS    &kp LS(LPAR)  &kp LS(LBRC)  &kp LBKT           &mo 5
&kp LS(TILDE)  &kp MINUS    &kp LS(PLUS)   &kp LS(POUND)     &kp LS(DLLR)  &kp LS(AT)  &kp LS(AMPS)  &kp LS(STAR)  &kp RA(LS(COMMA))  &kp RA(LS(DOT))
                            &kp SPACE      &kp DELETE        &trans        &trans      &trans        &trans
            >;
        };

        alt_sym_layer {
            bindings = <
&kp N1     &kp N2            &kp N3        &kp N4        &kp N5         &kp N6       &kp N7        &kp N8        &kp N9             &kp N0
&trans     &kp RA(LS(SEMI))  &kp RA(SEMI)  &kp LS(EXCL)  &kp BSLH       &kp LS(DQT)  &kp LS(RPAR)  &kp LS(RBRC)  &kp RBKT           &trans
&kp GRAVE  &kp LS(UNDER)     &kp EQUAL     &kp PIPE      &kp LS(PRCNT)  &kp LS(AT)   &kp CARET     &kp LS(STAR)  &kp RA(LS(COMMA))  &kp RA(LS(DOT))
                             &kp SPACE     &kp DELETE    &trans         &trans       &trans        &trans
            >;
        };
    };
};
